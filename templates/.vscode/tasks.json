{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Local Toolchain (GUI)",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/PathConfigurator.exe",
      "args": [
        "/workspace",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "label": "$(gear) 配置",
          "detail": "配置: 启动 STM32 项目配置器，设置当前工程的工具链、OpenOCD 和 CMake 构建目标配置。",
          "running": {
            "label": "$(sync~spin) 正在配置"
          }
        }
      },
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "CMake: Configure Debug",
      "type": "process",
      "command": "${config:CustomCfg.cmakePath}",
      "args": [
        "--preset",
        "Debug-Local"
      ],
      "options": {
        "cwd": "${workspaceFolder}/${config:CustomCfg.toolchainLocation}",
        "statusbar": {
          "hide": true
        }
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Release",
      "type": "process",
      "command": "${config:CustomCfg.cmakePath}",
      "args": [
        "--preset",
        "Release-Local"
      ],
      "options": {
        "cwd": "${workspaceFolder}/${config:CustomCfg.toolchainLocation}",
        "statusbar": {
          "hide": true
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "process",
      "command": "${config:CustomCfg.cmakePath}",
      "args": [
        "--build",
        "--preset",
        "Debug-Local"
      ],
      "options": {
        "cwd": "${workspaceFolder}/${config:CustomCfg.toolchainLocation}",
        "statusbar": {
          "label": "$(tools) 编译",
          "detail": "编译 Debug: 配置并编译 Debug 固件。",
          "running": {
            "label": "$(sync~spin) 正在编译"
          }
        }
      },
      "dependsOn": "CMake: Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Release",
      "type": "process",
      "command": "${config:CustomCfg.cmakePath}",
      "args": [
        "--build",
        "--preset",
        "Release-Local"
      ],
      "options": {
        "cwd": "${workspaceFolder}/${config:CustomCfg.toolchainLocation}",
        "statusbar": {
          "hide": true
        }
      },
      "dependsOn": "CMake: Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash Debug (OpenOCD)",
      "type": "process",
      "command": "${config:CustomCfg.openocdPath}",
      "args": [
        "-f",
        "interface/${config:CustomCfg.openocd.interface}.cfg",
        "-c",
        "transport select swd",
        "-f",
        "target/${config:CustomCfg.openocd.target}",
        "-c",
        "program build/Debug/${config:CustomCfg.projectName}.elf verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}/${config:CustomCfg.toolchainLocation}",
        "statusbar": {
          "label": "$(zap) 烧录",
          "detail": "烧录 Debug: 进行 Debug 任务的编译，并通过 OpenOCD 烧录、校验和复位。",
          "running": {
            "label": "$(sync~spin) 正在烧录"
          }
        }
      },
      "dependsOn": "Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "CMake: Clean Debug",
      "type": "process",
      "command": "${config:CustomCfg.cmakePath}",
      "args": [
        "-E",
        "remove_directory",
        "build/Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/${config:CustomCfg.toolchainLocation}",
        "statusbar": {
          "label": "$(trash) 清理",
          "detail": "清理 Debug: 删除 Debug 构建目录；下一次编译会重新配置。",
          "running": {
            "label": "$(sync~spin) 正在清理"
          }
        }
      },
      "problemMatcher": []
    }
  ]
}
